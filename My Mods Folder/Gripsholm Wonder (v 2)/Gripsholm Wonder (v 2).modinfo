<?xml version="1.0" encoding="utf-8"?>
<Mod id="a9efbd84-c934-4e58-acb2-717a4cd70b93" version="2">
  <Properties>
    <Name>Gripsholm Wonder</Name>
    <Teaser>Gripsholm Castle is a fortress located on the shore of Lake Mälaren, near the town of Mariefred, Sweden.</Teaser>
    <Description>Gripsholm Castle is a fortress located on the shore of Lake Mälaren, near the town of Mariefred, Sweden. It was built during the 16th century on the site of a medieval fortress, and served as the residence for the Swedish royal family throughout much of the following centuries. Gripsholm has also functioned as a prison and a museum during its lifetime. Ingame, Gripsholm provides +1 [ICON_CITIZEN] Population in every city, +2 [ICON_FOOD] food for every lake tile worked by the city, requires Printing Press and a fresh water source adjacent to the city.</Description>
    <Authors>Pouakai, sukritact</Authors>
    <SpecialThanks>Mentos, moriboe, Ambrox62, Onacadarfi XXVI</SpecialThanks>
