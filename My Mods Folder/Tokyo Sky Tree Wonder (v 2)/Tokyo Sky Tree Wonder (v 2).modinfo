<?xml version="1.0" encoding="utf-8"?>
<Mod id="6619c369-d9c1-4c3e-a931-cc682c140a94" version="2">
  <Properties>
    <Name>Tokyo Sky Tree Wonder</Name>
    <Teaser>Located near the Sumida river in Central Tokyo, the Tokyo Sky Tree is a 634 metre tall broadcasting and observation tower</Teaser>
    <Description>Located near the Sumida river in Central Tokyo, the Tokyo Sky Tree is a 634 metre tall broadcasting and observation tower visible from most of the metropolis. It was built over four years from 2008 to 2012, incorperating several aspects of traditional and modern Japanese design, as well as vast safety measures to protect the structure against the powerful earthquakes which frequent the Japanese mainland. Ingame, the Tokyo Sky Tree provides +1 Happiness and +1 Culture from every Broadcast tower in the empire, and requires Telecommunications.</Description>
    <Authors>Pouakai, janboruta</Authors>
    <SpecialThanks>sukritact</SpecialThanks>
