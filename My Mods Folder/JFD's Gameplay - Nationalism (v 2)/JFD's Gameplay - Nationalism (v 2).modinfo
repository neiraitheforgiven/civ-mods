<?xml version="1.0" encoding="utf-8"?>
<Mod id="c3b6e30c-3548-4fbc-9d7f-cf3025be8261" version="2">
  <Properties>
    <Name>JFD's Gameplay - Nationalism</Name>
    <Teaser>Adds [COLOR_CYAN]Nationalism[ENDCOLOR] as a new gameplay concept. Click for details.</Teaser>
    <Description>[COLOR_POSITIVE_TEXT]Nationalism[ENDCOLOR] is a new yield that can be expended to duplicate Social Policies that you have already adopted. Nationalism is generated from your Culture Per Turn; the amount of Culture Per Turn contributing to Nationalism instead of Culture is determined by a slider in the Social Policy screen. When you have enough Nationalism, it can then be spent to re-adopt Social Policies.[NEWLINE][NEWLINE]The amount of Culture Per Turn you can devote to Nationalism increases with certain Technologies.</Description>
    <Authors>JFD</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>1</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
