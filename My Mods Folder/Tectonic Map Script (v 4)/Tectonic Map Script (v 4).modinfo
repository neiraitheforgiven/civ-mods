  </Files>
  <Actions>
    <OnModActivated>
      <UpdateDatabase>Tectonic.xml</UpdateDatabase>
    </OnModActivated>
  </Actions>
  <EntryPoints>
    <EntryPoint type="MapScript" file="Tectonic.lua">
      <Name>Tectonic</Name>
