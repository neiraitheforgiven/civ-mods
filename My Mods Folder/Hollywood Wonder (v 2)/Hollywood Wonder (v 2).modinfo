<?xml version="1.0" encoding="utf-8"?>
<Mod id="88fc7896-7516-499c-9fe5-8fd4a6466681" version="2">
  <Properties>
    <Name>Hollywood Wonder</Name>
    <Teaser>The Los Angeles, USA district of Hollywood has long been associated with the American film industry.</Teaser>
    <Description>The Los Angeles, USA district of Hollywood has long been associated with the American film industry. It began life as a real estate development named "Hollywoodland" at the start of the 20th century, with the first film studio opening just over a decade later. Since then, Hollywood has been under continual development, with the district now home to several multi-million dollar companies. Ingame, Hollywood provides +1 Happiness for every theatre in the empire, and requires Electronics</Description>
    <Authors>Pouakai, sukritact</Authors>
    <SpecialThanks>ambrox62, Moriboe, mentos</SpecialThanks>
