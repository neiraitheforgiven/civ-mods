<?xml version="1.0" encoding="utf-8"?>
<Mod id="5b4d063d-1ee6-4b58-ac3d-a282037e7dc1" version="1">
  <Properties>
    <Name>Reedstilt's Native American Wonders - The Moundbuilders</Name>
    <Stability>Alpha</Stability>
    <Teaser>Adds five new World Wonders from various mound-building societies from eastern North America.</Teaser>
    <Description>Adds the following World Wonders:

The Bird Mound - Provides +1 Faith to all Bonus Resources worked by this City.

The Newark Earthworks - Extends land-based Trade Routes by 50% and all Trade Routes increase Tourism by 10%.

The Great Mound of Troyville - Gains +1 Production and +5 Golden Age Length for each adjacent River Tile.

The Monks Mound - Increases Gold from incoming Trade Routes and Melee Units trained in this City generate Gold from attacking Cities.

The Great Serpent Mound - Reveals Deer at every City; Deer, Bison, and Furs worked by this City gain +1 Food.</Description>
    <Authors>Reedstilt</Authors>
    <SpecialThanks>Neirai</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
