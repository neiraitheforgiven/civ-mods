<?xml version="1.0" encoding="utf-8"?>
<Mod id="fca4e30b-d90e-4b2d-bd1b-33a3708cac4e" version="3">
  <Properties>
    <Name>Taipei 101 Wonder</Name>
    <Teaser>Taipei 101 is a skyscraper located in the Taiwanese city of Taipei. It was completed in 2004, and was Earth's tallest building.</Teaser>
    <Description>Taipei 101 is a skyscraper located in the Taiwanese city of Taipei. It was completed in 2004, and was the tallest building in the world until the completion of the Burj Khalifa in 2010. The architecture of the building, despite being modern, features many traditional asian motifs and symbolism, among which the segments of eight floors through the height of the tower, with eight being a prosperous number in Taiwan. Ingame, Taipei 101 provides +10 Gold, and +1 Gold per citizen of the city</Description>
    <Authors>Pouakai, Sukritact</Authors>
    <SpecialThanks>Ambrox62, Moriboe, Mentos</SpecialThanks>
