<?xml version="1.0" encoding="utf-8"?>
<Mod id="56c0ea0c-bf73-4509-a0f8-215b589d1053" version="2">
  <Properties>
    <Name>Escadaria Selaron Wonder</Name>
    <Teaser>Escadaria Selaron is an iconic stairway mosaic located in Rio de Janiero, Brazil. It is the brainchild of a Chilean-born artist</Teaser>
    <Description>Escadaria Selaron is an iconic stairway mosaic located in Rio de Janiero, Brazil. It is the brainchild of Chilean-born artist Jorge Selarón, who began renovating the stairs in 1990. The stairs are now a world icon, having featured in music videos, magazines and movies. The tiles have been collected and donated from a variety of sources across 60 countries, and are now donated by visitors to the stairs. Ingame, Escadaria Selarón provides +3 [ICON_GOLD] Gold from Artistic specialists, as well as +4 [ICON_HAPPINESS_1] Happiness and 6 Tourism, while it requires Replaceable Parts.</Description>
    <Authors>Pouakai, jpbar81</Authors>
    <SpecialThanks>sukritact, Ambrox62, chrisifniotis</SpecialThanks>
