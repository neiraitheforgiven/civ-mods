<?xml version="1.0" encoding="utf-8"?>
<Mod id="de1a22c7-b325-44f0-adad-78a666435c4a" version="2">
  <Properties>
    <Name>Petronas Towers Wonder</Name>
    <Teaser>An icon of both Malaysia and Kuala Lumpur, the Petronas Towers stretch 451.9 metres above the ground. This makes them the talles</Teaser>
    <Description>An icon of both Malaysia and Kuala Lumpur, the Petronas Towers stretch 451.9 metres above the ground. This makes them the tallest twin tower structure on Earth, and from 1998 to 2004 they were the world's tallest buildings. Their design has roots within Islamic art, with the design stemming from a symbol featuring on the flags of many islamic nations. Ingame, the Petronas towers give a free Great Person, which spawns near the capital</Description>
    <Authors>Pouakai, sukritact</Authors>
    <SpecialThanks>Mentos, Moriboe, Ambrox62</SpecialThanks>
