<?xml version="1.0" encoding="utf-8"?>
<Mod id="ecc0e8c0-6a0f-402d-b2ba-23a60546cbba" version="2">
  <Properties>
    <Name>Chogha Zanbil Wonder</Name>
    <Teaser>Chogha Zanbil is the world's best preserved Ziggurat</Teaser>
    <Description>Chogha Zanbil is the world's best preserved Ziggurat, and one of the few located outside of the Mesopotamia region, instead being found in modern day Iran where it was built by Elamites around 1250 BCE. The Ziggurat is dedicated mainly to the god Inshushinak, although smaller temples within the site honour many other gods of the same Pantheon. Ingame, Chogha Zanbil provides a free temple in the city in which it is built, as well as +2 faith, while it requires Bronze Working.</Description>
    <Authors>Pouakai, sukritact</Authors>
