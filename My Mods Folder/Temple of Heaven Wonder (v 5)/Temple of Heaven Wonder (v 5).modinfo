<?xml version="1.0" encoding="utf-8"?>
<Mod id="a954965d-ec7b-4e34-a5b6-5b4f4376e429" version="5">
  <Properties>
    <Name>Temple of Heaven Wonder</Name>
    <Teaser>The Temple of Heaven is a large religious complex in the centre of Beijing, China. It was constructed in the 15th century</Teaser>
    <Description>The Temple of Heaven is a large religious complex in the centre of Beijing, China. It was constructed in the 15th century during the reign of the Yongle Emperor, and features elements of Taoism and Heaven worship, among which was an annual festival dedicated to heaven. The complex was occupied by the eight-nation alliance during the Boxer rebellion in 1900, and was not opened to the public until 1918.</Description>
    <Authors>Pouakai, sukritact</Authors>
    <SpecialThanks>ambrox62, moriboe</SpecialThanks>
