<?xml version="1.0" encoding="utf-8"?>
<Mod id="b7033572-5293-4d1e-a7d1-576ade8ede7c" version="5">
  <Properties>
    <Name>Oriental Pearl Tower Wonder</Name>
    <Teaser>This mod adds the Oriental Pearl Tower of Shanghai, China to the game as a Wonder,</Teaser>
    <Description>The Oriental Pearl Tower is a television tower located in Shanghai, China, on the bank of the Huangpu River. It has become an icon of Shanghai and China alike, and is comprised of 11 spheres, two of which have amenities such as observation floors and a rotating restaurant. Construction began in 1990, and took four years to complete. On the seventh of July, 2007 the tower served as the Chinese location for Live Earth, a worldwide Music concert. Ingame, the Oriental Pearl Tower provides +10% Culture and Great Person generation in all cities, and becomes available with Telecommunications</Description>
    <Authors>Pouakai; Sukritact</Authors>
    <SpecialThanks>ambrox62, moriboe,</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>0</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
