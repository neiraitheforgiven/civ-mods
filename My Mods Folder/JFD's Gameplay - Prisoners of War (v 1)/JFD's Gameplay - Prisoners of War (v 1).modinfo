<?xml version="1.0" encoding="utf-8"?>
<Mod id="0c77b764-f39f-45cf-8730-3190da3f5b2a" version="1">
  <Properties>
    <Name>JFD's Gameplay - Prisoners of War</Name>
    <Teaser>Adds [COLOR_CYAN]Prisoners of War[ENDCOLOR] as a new gameplay concept. Click for details.</Teaser>
    <Description>[COLOR_POSITIVE_TEXT]Prisoners of War[ENDCOLOR] is a new gameplay mechanic resulting from your combat victories. Successfully defeating an enemy unit now has a chance to leave you with prisoners of war, based on the advancement of your military Technologies. Prisoners of War must be dealt with through one of several actions, each rewarding a different Yield.</Description>
    <Authors>JFD</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>1</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
