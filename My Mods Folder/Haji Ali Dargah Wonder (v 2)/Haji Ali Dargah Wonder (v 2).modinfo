<?xml version="1.0" encoding="utf-8"?>
<Mod id="69d732aa-bc75-40d7-95d1-cd53c93cde95" version="2">
  <Properties>
    <Name>Haji Ali Dargah Wonder</Name>
    <Teaser>Located in the Arabian Sea just off the coast of Mumbai, India, Haji Ali Dargah is an iconic Mosque and Tomb.</Teaser>
    <Description>Haji Ali Dargah is a Mosque and Tomb built on an islet in the Arabian Sea, off the coast of Mumbai, India. It is connected to the mainland via a narrow causeway, which floods in high tide. Despite this, an average of 80,000 people visit the Mosque every week, 40,000 each on Thursdays and Fridays. Ingame, Haji Ali Dargah provides +20% Gold from  Trade Routes and +2  Gold from every sea tile. It becomes available with Navigation.</Description>
    <Authors>Pouakai, sukritact</Authors>
    <SpecialThanks>Moriboe, Ambrox62</SpecialThanks>
