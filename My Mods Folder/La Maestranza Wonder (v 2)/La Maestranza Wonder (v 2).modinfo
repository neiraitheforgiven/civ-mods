<?xml version="1.0" encoding="utf-8"?>
<Mod id="8584b5c9-aca5-4e5b-82cb-844fd502657e" version="2">
  <Properties>
    <Name>La Maestranza Wonder</Name>
    <Teaser>Located in the heart of the Spanish city of Seville, La Maestranza is the oldest bullring in Spain, dating back to 1749</Teaser>
    <Description>La Maestranza is the oldest bullring in Spain, having been completed over a hundred and thirty years ago. It is said to be the most demanding and challenging arena for matadors, as the crowd is very knowledgeable on the subject. Ingame, La Maestranza provies +6 Happiness, as well as +4 Culture from every source of Cattle worked by the city; it requires Archaeology.</Description>
    <Authors>Pouakai, jpbar81</Authors>
    <SpecialThanks>whoward69, Ambrox62</SpecialThanks>
