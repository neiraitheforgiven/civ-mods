<?xml version="1.0" encoding="utf-8"?>
<Mod id="6c1422af-1255-4d89-92c3-cfb2be977c13" version="2">
  <Properties>
    <Name>Darjeeling Himalayan Railway Wonder</Name>
    <Teaser>The Darjeeling Himalayan Railway is the most famous of the railways featured in the 'Mountain Railways of India' UNESCO World H</Teaser>
    <Description>The Darjeeling Himalayan Railway is the most famous of the railways featured in the 'Mountain Railways of India' UNESCO World Hertiage site. It was built during the British Raj period of Indian colonisation in order to provide access to the mountain city of Darjeeling and the rich tea plantations which surround it. It is widely known as the 'Toy Train', as it is a very small train with only a two-foot gauge of railroad track. Ingame, the Darjeeling Himalayan Railway provides 3 sources of the Tea resource and an additional +3 Happiness, while it requires Railroad and must be built in a city on a hill tile.</Description>
    <Authors>Pouakai, janboruta, sukritact</Authors>
