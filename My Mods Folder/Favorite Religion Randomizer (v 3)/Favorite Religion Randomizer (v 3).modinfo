<?xml version="1.0" encoding="utf-8"?>
<Mod id="5c503633-2b9c-4ab0-ba44-ef95d971c07f" version="3">
  <Properties>
    <Name>Favorite Religion Randomizer</Name>
    <Teaser>Favorite Religion Randomizer</Teaser>
    <Description>A mod that randomly assigns to any civilizations (including civilizations from mods) any from the religions available (including religions from mods).[NEWLINE][NEWLINE]Whenever possible the same religion will not be assigned twice to different civilizations, so to ensure the best performance make sure that there are more religions than civilizations (the total number counts, not just those participating in a given game), or at least a very good amount of those.[NEWLINE][NEWLINE]The randomness is ensured only regarding the civilizations's first pick. If someone else got it (including the human player) this mod has no effect whatsoever on what will be chosen instead (which is usually selected from a predefined list starting with Buddhims followed by Christianity etc etc).</Description>
    <Authors>Ryoga</Authors>
    <SpecialThanks>Nutty</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>0</AffectsSavedGames>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
